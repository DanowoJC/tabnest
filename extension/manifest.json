{
  "manifest_version": 3,
  "name": "TabNest",
  "short_name": "TabNest",
  "description": "Smart tab session manager: save and restore sessions, auto-group tabs by task, archive idle tabs, find duplicates and search everything.",
  "version": "1.0.1",
  "author": "DanowoJC",
  "homepage_url": "https://github.com/DanowoJC/tabnest",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "TabNest",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "src/manager/manager.html"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "unlimitedStorage",
    "alarms",
    "sidePanel",
    "favicon"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+K", "mac": "Command+Shift+K" },
      "description": "Open TabNest search"
    },
    "save-window": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Save the current window as a session"
    },
    "open-manager": {
      "suggested_key": { "default": "Alt+Shift+M" },
      "description": "Open the TabNest manager"
    },
    "close-duplicates": {
      "description": "Close duplicate tabs"
    }
  },
  "minimum_chrome_version": "121"
}
